# ─────────────────────────────────────────────────────────────────────────────
# Rally — frontend environment variables
# Copy this file to `.env.local` for local development:   cp .env.example .env.local
# On Cloudflare Pages, add the same variables under
#   Settings → Variables and Secrets (Production AND Preview).
#
# Every VITE_* variable is compiled into the public JavaScript bundle.
# Only put values here that are SAFE TO PUBLISH.
# NEVER put the Supabase service_role / secret key in any VITE_* variable.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL — Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase client key that is safe for browsers.
# Dashboard → Project Settings → API Keys → "Publishable key" (sb_publishable_…)
# The legacy "anon public" JWT key also works here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Public URL of the deployed site, used when building share links and
# join QR codes. Leave empty to use the browser's current origin.
# Example: https://rally-quiz.pages.dev
VITE_PUBLIC_SITE_URL=
